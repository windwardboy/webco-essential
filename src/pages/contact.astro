---
import EnquiryForm from "../components/EnquiryForm.astro";
import PageHero from "../components/PageHero.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import Section from "../components/Section.astro";
import { afterEnquiry } from "../content/process";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { httpsUrl, pageCrumbs } from "../lib/links";

const crumbs = pageCrumbs([{ label: "Contact", href: "/contact/" }]);
const mapUrl = httpsUrl(site.mapEmbedUrl);
---

<BaseLayout
  title="Contact us"
  description={`Call, email or send an enquiry about HGV training from one local base in ${site.location.town}. Fictional demonstration provider: the contact details and form are placeholders.`}
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Get in touch"
    title="Contact us"
    lede="Call, email or send the short enquiry form. Tell us which course you're interested in and how you'd like us to reply. The phone number, email and form on this demonstration site are placeholders."
  />

  <div class="block band">
    <div class="wrap contact-layout">
      <section aria-labelledby="enquiry">
        <h2 id="enquiry">Send an enquiry</h2>
        <p class="section-intro">Tell us which course you're asking about and how you'd like us to get in touch.</p>
        <div class="enquiry-offset">
          <EnquiryForm />
        </div>
      </section>
      <address class="contact-card">
        <h2>Phone and email</h2>
        <ul class="contact-list">
          <li>
            <a href={site.phoneHref}>{site.phoneDisplay}</a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          {
            site.showWhatsApp ? (
              <li>
                <a href={site.whatsappHref} rel="noopener noreferrer">
                  WhatsApp {site.whatsappDisplay}
                </a>
              </li>
            ) : null
          }
        </ul>
        <p class="example-caption">Placeholder contact details for the demonstration.</p>
      </address>
    </div>
  </div>

  <Section id="address" title="Training address" intro={site.location.summary}>
    <div class="place-grid">
      <div>
        <p class="address">
          {site.location.town}, {site.location.county}
        </p>
        {
          site.location.addressLines.length > 0 ? (
            <p>
              {site.location.addressLines.map((line) => (
                <>
                  {line}
                  <br />
                </>
              ))}
            </p>
          ) : (
            <p class="example-caption">{site.location.addressNote}</p>
          )
        }
      </div>
      {
        mapUrl ? (
          <iframe
            class="map-frame"
            title={`Map of the training base in ${site.location.town}`}
            src={mapUrl}
            loading="lazy"
            referrerpolicy="no-referrer"
          />
        ) : (
          <div class="map-placeholder">
            <p class="map-placeholder-title">Map</p>
            <p>{site.location.mapNote}</p>
          </div>
        )
      }
    </div>
  </Section>

  <Section id="hours" title="Contact hours" intro={site.location.hoursNote} band={true}>
    <dl class="hours">
      {
        site.location.hours.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="example-caption">Placeholder hours for the demonstration.</p>
  </Section>

  <Section id="areas" title="Areas served" intro={site.location.areasNote}>
    <ul class="area-list">
      {site.location.areasServed.map((area) => <li>{area}</li>)}
    </ul>
  </Section>

  <ProcessSteps
    id="after"
    title="What happens after you enquire"
    intro="A simple sequence, so you know what to expect."
    steps={afterEnquiry}
    band={true}
  />
</BaseLayout>
