---
import EnquiryForm from "../components/EnquiryForm.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Example phone, email and enquiry form for a Webco Essential training website. Messages are not sent."
>
  <PageHero
    title="Contact"
    lede="Phone, email and a short enquiry form. The details on this page are placeholders, and the form does not send a message."
  />
  <div class="block block-follow">
    <div class="wrap contact-layout">
      <address class="contact-card">
        <h2>Example contact details</h2>
        <p>
          <strong>{site.location.town}, {site.location.county}</strong>
        </p>
        <p class="example-caption">{site.location.summary}</p>
        <ul class="contact-list">
          <li>
            <a href={site.phoneHref}>{site.phoneDisplay}</a>
            <span class="example-tag">Example number</span>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <span class="example-tag">Example address</span>
          </li>
          {
            site.showWhatsApp ? (
              <li>
                <a href={site.whatsappHref} rel="noopener noreferrer">
                  WhatsApp {site.whatsappDisplay}
                </a>
                <span class="example-tag">Example number</span>
              </li>
            ) : null
          }
        </ul>
      </address>
      <section aria-labelledby="enquiry">
        <h2 id="enquiry">Enquiry form</h2>
        <div class="enquiry-offset">
          <EnquiryForm />
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
