---
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import TestimonialList from "../components/TestimonialList.astro";
import { testimonials } from "../content/testimonials";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { httpsUrl, pageCrumbs } from "../lib/links";

const crumbs = pageCrumbs([{ label: "Reviews", href: "/reviews/" }]);
const googleReviews = httpsUrl(site.googleReviewsUrl);
---

<BaseLayout
  title="Reviews"
  description="What learners say about HGV training from a fictional provider on a Webco Essential demonstration website. All reviews are samples."
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Reviews"
    title="What our learners say"
    lede="Comments on Category C, Category C+E and Driver CPC training. The reviews on this page are fictional samples written for this demonstration, and no rating or review count is shown."
  >
    <div class="actions">
      <a class="button" href="/contact/#enquiry">Enquire now</a>
      <a class="button button-quiet" href="/hgv-training/">View HGV training</a>
    </div>
  </PageHero>

  <Section id="testimonials" title="Learner comments" intro="A short comment from a learner on each of our courses.">
    <TestimonialList items={testimonials} />
  </Section>

  <Section
    id="stories"
    title="Longer reviews"
    intro="Fuller comments from the same sample learners."
    band={true}
  >
    <TestimonialList items={testimonials} detailed={true} stacked={true} />
  </Section>

  <Section id="google" title="Google reviews" intro={googleReviews ? "Prefer to read more? See what learners have said about us on Google." : site.googleReviewsNote}>
    {
      googleReviews ? (
        <div class="actions">
          <a class="button" href={googleReviews} rel="noopener noreferrer">
            Read the Google reviews
          </a>
        </div>
      ) : null
    }
  </Section>

  <CtaBand
    title="Ask about training"
    text="Tell us which course you're interested in and we'll take it from there."
  />
</BaseLayout>
