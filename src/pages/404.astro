---
import { trainingOverviewPath } from "../content/courses";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="That page is not on this Webco Essential demonstration website."
  noindex={true}
>
  <section class="hero missing">
    <div class="wrap">
      <p class="eyebrow">Page not found</p>
      <h1>Sorry, we can't find that page</h1>
      <p class="lede">The link may be out of date, but you can still browse our training or get in touch.</p>
      <div class="actions">
        <a class="button" href="/">Back to the homepage</a>
        <a class="button button-quiet" href={trainingOverviewPath}>View HGV training</a>
        <a class="button button-text" href="/contact/#enquiry">Enquire now</a>
      </div>
    </div>
  </section>
</BaseLayout>
