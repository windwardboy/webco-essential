---
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import LocationPanel from "../components/LocationPanel.astro";
import PageHero from "../components/PageHero.astro";
import RelatedTraining from "../components/RelatedTraining.astro";
import Section from "../components/Section.astro";
import { courseById, cpcPriceNote, driverCpc, enquiryHref, trainingOverviewPath } from "../content/courses";
import { faqs } from "../content/faqs";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageCrumbs } from "../lib/links";

const course = courseById("driver-cpc");
const categoryCCourse = courseById("category-c");
const categoryCeCourse = courseById("category-ce");
const crumbs = pageCrumbs([
  { label: "HGV training", href: trainingOverviewPath },
  { label: course.navLabel, href: course.path },
]);
---

<BaseLayout
  title="Driver CPC training"
  description={`Periodic Driver CPC training for professional lorry and bus drivers, from one local base in ${site.location.town}. Fictional demonstration provider.`}
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow={`Driver CPC · ${site.location.town}`}
    title="Driver CPC training"
    lede="Periodic training for professional lorry and bus drivers who need to keep their Driver Qualification Card up to date. Driver CPC is not a vehicle category."
  >
    <div class="actions">
      <a class="button" href={enquiryHref(course.id)}>Enquire about {course.title}</a>
      <a class="button button-quiet" href={site.phoneHref}>Call {site.phoneDisplay}</a>
    </div>
  </PageHero>

  <Section id="what" title="What Driver CPC is" intro={driverCpc.what} band={true} narrow={true}>
    <p>
      The vehicle licences are <a href={categoryCCourse.path}>{categoryCCourse.title}</a> and
      <a href={categoryCeCourse.path}>{categoryCeCourse.title}</a>.
    </p>
  </Section>

  <Section id="who" title="Who needs it" intro={driverCpc.who} narrow={true} />

  <Section
    id="types"
    title="Initial and periodic CPC"
    intro="Two stages of the same qualification. We offer the periodic stage."
    band={true}
  >
    <ul class="cards">
      <li class="card">
        <p class="card-kicker">Initial</p>
        <h3>New professional drivers</h3>
        <p>{driverCpc.initial}</p>
      </li>
      <li class="card">
        <p class="card-kicker">Periodic</p>
        <h3>Drivers who already hold a card</h3>
        <p>{driverCpc.periodic}</p>
      </li>
    </ul>
  </Section>

  <Section id="offered" title="Courses we offer" intro="What we offer, and what we don't.">
    <ul class="cards">
      <li class="card">
        <p class="card-kicker">Offered</p>
        <h3>{driverCpc.offeredTitle}</h3>
        <p>{driverCpc.offeredText}</p>
      </li>
      <li class="card">
        <p class="card-kicker">Not offered</p>
        <h3>Initial Driver CPC</h3>
        <p>{driverCpc.initialNotOffered}</p>
      </li>
    </ul>
  </Section>

  <Section id="format" title="Format and duration" intro={driverCpc.format} band={true} narrow={true} />

  <Section id="price" title="Price and quotes" intro={cpcPriceNote} narrow={true}>
    <div class="actions">
      <a class="button" href={enquiryHref(course.id)}>Ask for a {course.title} quote</a>
    </div>
  </Section>

  <LocationPanel id="location" title="Training location" band={true} />
  <FaqList id="faq" title="Common questions" items={faqs["driver-cpc"]} />

  <Section id="related" title="Other training" intro="The training overview and the vehicle licences." band={true}>
    <RelatedTraining excludeId="driver-cpc" />
  </Section>

  <CtaBand
    id="cta"
    title="Enquire about Driver CPC"
    text="Tell us you're asking about periodic training, and how you'd like us to get in touch."
    primaryHref={enquiryHref(course.id)}
    primaryLabel={`Enquire about ${course.title}`}
  />
</BaseLayout>
