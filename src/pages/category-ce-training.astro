---
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import LocationPanel from "../components/LocationPanel.astro";
import PageHero from "../components/PageHero.astro";
import RelatedTraining from "../components/RelatedTraining.astro";
import Section from "../components/Section.astro";
import TestimonialList from "../components/TestimonialList.astro";
import { categoryCe, durationNote, priceNote } from "../content/courses";
import { faqs } from "../content/faqs";
import { testimonialsFor } from "../content/testimonials";
import { trustPoints } from "../content/trust";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageCrumbs } from "../lib/links";

const crumbs = pageCrumbs([
  { label: "HGV training", href: "/hgv-training/" },
  { label: "Category C+E", href: "/category-ce-training/" },
]);
---

<BaseLayout
  title="Category C+E training"
  description={`Category C+E articulated and drawbar training from one local base in ${site.location.town}, for drivers who already hold Category C. Fictional demonstration provider.`}
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow={`Category C+E · ${site.location.town}`}
    title="Category C+E training"
    lede="Trailer training for articulated lorries and drawbar combinations. This page explains the licence and the practical work involved."
  >
    <div class="actions">
      <a class="button" href="/contact/?course=category-ce#enquiry">Enquire about Category C+E</a>
      <a class="button button-quiet" href={site.phoneHref}>Call {site.phoneDisplay}</a>
    </div>
  </PageHero>

  <Section id="drive" title="What C+E allows you to drive" intro={categoryCe.driveIntro} band={true} narrow={true}>
    <ul class="prose-list">
      {categoryCe.drivePoints.map((item) => <li>{item}</li>)}
    </ul>
    <p>{categoryCe.driveNote}</p>
  </Section>

  <Section id="who" title="Who it is for" intro={categoryCe.who} narrow={true}>
    <p>
      If you're still moving up from a car licence, start with
      <a href="/category-c-training/">Category C training</a>.
    </p>
  </Section>

  <Section
    id="eligibility"
    title="Eligibility guidance"
    intro="General guidance only. We check the licence you hold when you enquire."
    band={true}
    narrow={true}
  >
    <ul class="prose-list">
      {categoryCe.eligibility.map((item) => <li>{item}</li>)}
    </ul>
  </Section>

  <Section id="programme" title="Training programme" intro="The practical work a C+E course is built around." narrow={true}>
    <ul class="prose-list">
      {categoryCe.includes.map((item) => <li>{item}</li>)}
    </ul>
  </Section>

  <Section
    id="environment"
    title="Vehicle and training environment"
    intro={categoryCe.environment}
    band={true}
    narrow={true}
  >
    <p>{categoryCe.environmentNote}</p>
  </Section>

  <Section id="duration" title="How long it takes" intro={durationNote} narrow={true} />

  <Section id="price" title="Price and quotes" intro={priceNote} band={true} narrow={true}>
    <div class="actions">
      <a class="button" href="/contact/?course=category-ce#enquiry">Ask for a Category C+E quote</a>
    </div>
  </Section>

  <Section id="why" title="Why train with us">
    <ul class="trust">
      {
        trustPoints.map((point) => (
          <li>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <LocationPanel id="location" title="Training location" band={true} />

  <Section
    id="proof"
    title="What learners say"
    intro="A sample review for this demonstration. It is fictional and not real feedback."
  >
    <TestimonialList items={testimonialsFor("category-ce")} />
    <div class="actions">
      <a class="button button-quiet" href="/reviews/">Read more reviews</a>
    </div>
  </Section>

  <FaqList id="faq" title="Common questions" items={faqs["category-ce"]} band={true} />

  <Section id="related" title="Other training" intro="The rest of our courses.">
    <RelatedTraining excludeId="category-ce" />
  </Section>

  <CtaBand
    id="cta"
    title="Enquire about Category C+E"
    text="Tell us whether you already hold Category C, and how you'd like us to get in touch."
    primaryHref="/contact/?course=category-ce#enquiry"
    primaryLabel="Enquire about Category C+E"
  />
</BaseLayout>
