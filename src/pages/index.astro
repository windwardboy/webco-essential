---
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import LocationPanel from "../components/LocationPanel.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import RouteCards from "../components/RouteCards.astro";
import Section from "../components/Section.astro";
import TestimonialList from "../components/TestimonialList.astro";
import TrustStrip from "../components/TrustStrip.astro";
import { faqs } from "../content/faqs";
import { trainingJourney } from "../content/process";
import { testimonials } from "../content/testimonials";
import { trustPoints } from "../content/trust";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const image = site.heroImage;
---

<BaseLayout
  title="HGV training"
  description={`Category C, Category C+E and Driver CPC training from one local base in ${site.location.town}. A fictional provider on a Webco Essential demonstration website.`}
>
  <section class:list={["hero", image.src && "has-photo"]}>
    {
      image.src ? (
        <div class="hero-media">
          <ResponsiveImage
            src={image.src}
            webp={image.webp}
            avif={image.avif}
            alt={image.alt}
            width={image.width}
            height={image.height}
            sizes="(min-width: 64rem) 78vw, 100vw"
            priority={true}
          />
        </div>
      ) : null
    }
    <div class="wrap">
      <p class="eyebrow">HGV training · {site.location.town}</p>
      <h1>Practical lorry training from one local base</h1>
      <p class="lede">
        Category C, Category C+E and Driver CPC, taught from one training base. Straightforward advice, time in the
        vehicle and an easy way to get in touch.
      </p>
      <div class="actions">
        <a class="button" href="/contact/#enquiry">Enquire now</a>
        <a class="button button-quiet" href={site.phoneHref}>Call us</a>
      </div>
      <p class="example-caption">
        Fictional demonstration: {site.location.town} and {site.phoneDisplay} are placeholders, and this is not a real training business.
      </p>
    </div>
  </section>

  <TrustStrip />
  <RouteCards />

  <Section id="why" title="Why train with us">
    <ul class="trust">
      {
        trustPoints.map((point) => (
          <li>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <ProcessSteps
    id="how"
    title="How HGV training works"
    intro="From first enquiry to training day, in four steps."
    steps={trainingJourney}
    band={true}
  />

  <Section
    id="proof"
    title="What learners say"
    intro="Sample reviews for this demonstration. They are fictional and not real feedback."
  >
    <TestimonialList items={testimonials} />
    <div class="actions">
      <a class="button button-quiet" href="/reviews/">Read more reviews</a>
    </div>
  </Section>

  <LocationPanel id="location" title={`Training in ${site.location.town}`} band={true} />
  <FaqList id="faq" title="Common questions" items={faqs.home} />
  <CtaBand
    title="Ask about training"
    text="Tell us which licence you are aiming for, or that you are not sure yet, and we will point you in the right direction."
  />
</BaseLayout>
