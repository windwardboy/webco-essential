---
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import LocationPanel from "../components/LocationPanel.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import RouteCards from "../components/RouteCards.astro";
import Section from "../components/Section.astro";
import TestimonialList from "../components/TestimonialList.astro";
import TrustStrip from "../components/TrustStrip.astro";
import { faqs } from "../content/faqs";
import { trainingJourney } from "../content/process";
import { testimonials } from "../content/testimonials";
import { trustPoints } from "../content/trust";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const image = site.heroImage;
---

<BaseLayout
  title="HGV training"
  description={`Demonstration of an Essential HGV training website for a provider based in ${site.location.town}. Category C, Category C+E and Driver CPC, with one training base and a simple enquiry.`}
>
  <section class:list={["hero", image.src && "has-photo"]}>
    {
      image.src ? (
        <div class="hero-media">
          <ResponsiveImage
            src={image.src}
            webp={image.webp}
            avif={image.avif}
            alt={image.alt}
            width={image.width}
            height={image.height}
            sizes="(min-width: 64rem) 78vw, 100vw"
            priority={true}
          />
        </div>
      ) : null
    }
    <div class="wrap">
      <p class="eyebrow">HGV training · {site.location.town}</p>
      <h1>Practical lorry training from one local base</h1>
      <p class="lede">
        Category C, Category C+E and Driver CPC. Straightforward advice and time in the vehicle, with a
        simple way to enquire.
      </p>
      <div class="actions">
        <a class="button" href="/contact/#enquiry">Enquire now</a>
        <a class="button button-quiet" href={site.phoneHref}>Call us</a>
      </div>
      <p class="example-caption">
        {site.location.town} and {site.phoneDisplay} are placeholders. This is not a real training business.
      </p>
    </div>
  </section>

  <TrustStrip />
  <RouteCards />

  <Section
    id="why"
    title="Why train with us"
    intro="Example wording for a small provider. No statistics, awards or pass rates are shown."
  >
    <ul class="trust">
      {
        trustPoints.map((point) => (
          <li>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <ProcessSteps
    id="how"
    title="How HGV training works"
    intro="A simple sequence. Durations are not stated, because none are published on this demonstration."
    steps={trainingJourney}
    band={true}
  />

  <Section
    id="proof"
    title="Learner proof"
    intro="Example wording for the layout. These are not real reviews, and no score is shown."
  >
    <TestimonialList items={testimonials} />
    <div class="actions">
      <a class="button button-quiet" href="/reviews/">Read the reviews page</a>
    </div>
  </Section>

  <LocationPanel id="location" title={`Training in ${site.location.town}`} band={true} />
  <FaqList id="faq" title="Questions" items={faqs.home} />
  <CtaBand
    title="Ask about training"
    text="Say which licence you are aiming for, or say that you are not sure yet."
  />
</BaseLayout>
