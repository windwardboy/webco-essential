---
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import LocationPanel from "../components/LocationPanel.astro";
import PageHero from "../components/PageHero.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import RelatedTraining from "../components/RelatedTraining.astro";
import Section from "../components/Section.astro";
import TestimonialList from "../components/TestimonialList.astro";
import { categoryC, durationNote, priceNote } from "../content/courses";
import { faqs } from "../content/faqs";
import { testimonialsFor } from "../content/testimonials";
import { trustPoints } from "../content/trust";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageCrumbs } from "../lib/links";

const crumbs = pageCrumbs([
  { label: "HGV training", href: "/hgv-training/" },
  { label: "Category C", href: "/category-c-training/" },
]);
---

<BaseLayout
  title="Category C training"
  description={`Category C rigid lorry training from one local base in ${site.location.town}: who it's for, what you can drive and how to ask for a quote. Fictional demonstration provider.`}
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow={`Category C · ${site.location.town}`}
    title="Category C training"
    lede="Practical training for rigid lorries over 3.5 tonnes. This page explains who the course is for, what you can drive and how the training works."
  >
    <div class="actions">
      <a class="button" href="/contact/?course=category-c#enquiry">Enquire about Category C</a>
      <a class="button button-quiet" href={site.phoneHref}>Call {site.phoneDisplay}</a>
    </div>
  </PageHero>

  <Section id="who" title="Who Category C is for" intro={categoryC.who} band={true} narrow={true}>
    <p>
      If you already hold Category C and need a trailer, see
      <a href="/category-ce-training/">Category C+E training</a>.
    </p>
  </Section>

  <Section id="drive" title="What you can drive" intro={categoryC.driveIntro} narrow={true}>
    <ul class="prose-list">
      {categoryC.drivePoints.map((item) => <li>{item}</li>)}
    </ul>
    <p>{categoryC.driveNote}</p>
  </Section>

  <Section
    id="eligibility"
    title="Eligibility and prerequisites"
    intro="General guidance only. We check the licence you hold when you enquire."
    band={true}
    narrow={true}
  >
    <ul class="prose-list">
      {categoryC.eligibility.map((item) => <li>{item}</li>)}
    </ul>
    <p>
      Paid work may also involve <a href="/driver-cpc/">Driver CPC</a>. That is a separate qualification.
    </p>
  </Section>

  <Section id="includes" title="What training includes" narrow={true}>
    <ul class="prose-list">
      {categoryC.includes.map((item) => <li>{item}</li>)}
    </ul>
  </Section>

  <ProcessSteps
    id="how"
    title="How the course works"
    intro="Four steps, from your first enquiry to the practical test."
    steps={categoryC.steps}
    band={true}
  />

  <Section id="duration" title="How long it takes" intro={durationNote} narrow={true} />

  <Section id="price" title="Price and quotes" intro={priceNote} band={true} narrow={true}>
    <div class="actions">
      <a class="button" href="/contact/?course=category-c#enquiry">Ask for a Category C quote</a>
    </div>
  </Section>

  <Section id="why" title="Why train with us">
    <ul class="trust">
      {
        trustPoints.map((point) => (
          <li>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <LocationPanel id="location" title="Training location" band={true} />

  <Section
    id="proof"
    title="What learners say"
    intro="A sample review for this demonstration. It is fictional and not real feedback."
  >
    <TestimonialList items={testimonialsFor("category-c")} />
    <div class="actions">
      <a class="button button-quiet" href="/reviews/">Read more reviews</a>
    </div>
  </Section>

  <FaqList id="faq" title="Common questions" items={faqs["category-c"]} band={true} />

  <Section id="related" title="Other training" intro="The rest of our courses.">
    <RelatedTraining excludeId="category-c" />
  </Section>

  <CtaBand
    id="cta"
    title="Enquire about Category C"
    text="Tell us you're interested in a rigid lorry, and how you'd like us to get in touch."
    primaryHref="/contact/?course=category-c#enquiry"
    primaryLabel="Enquire about Category C"
  />
</BaseLayout>
