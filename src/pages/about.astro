---
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import TestimonialList from "../components/TestimonialList.astro";
import { aboutIntro, aboutSections } from "../content/about";
import { testimonials } from "../content/testimonials";
import { trustPoints } from "../content/trust";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageCrumbs } from "../lib/links";

const crumbs = pageCrumbs([{ label: "About", href: "/about/" }]);
---

<BaseLayout
  title="About us"
  description={`About a small HGV training business teaching from one local base in ${site.location.town}: who we are, how we teach and where we train. Fictional demonstration provider.`}
  crumbs={crumbs}
>
  <PageHero crumbs={crumbs} eyebrow={aboutIntro.eyebrow} title={aboutIntro.title} lede={aboutIntro.lede}>
    <div class="actions">
      <a class="button" href="/hgv-training/">View HGV training</a>
      <a class="button button-quiet" href="/contact/#enquiry">Enquire now</a>
    </div>
  </PageHero>

  {
    aboutSections.map((section, index) => (
      <Section id={section.id} title={section.heading} band={index % 2 === 0} narrow={true}>
        {section.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </Section>
    ))
  }

  <Section id="why" title="Why train with us" band={aboutSections.length % 2 === 0}>
    <ul class="trust">
      {
        trustPoints.map((point) => (
          <li>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    id="proof"
    title="What learners say"
    intro="Sample reviews for this demonstration. They are fictional and not real feedback."
    band={aboutSections.length % 2 !== 0}
  >
    <TestimonialList items={testimonials} />
    <div class="actions">
      <a class="button button-quiet" href="/reviews/">Read more reviews</a>
    </div>
  </Section>

  <CtaBand
    title="Talk to us"
    text="Ask about Category C, Category C+E or Driver CPC and we will help you work out the right next step."
  />
</BaseLayout>
