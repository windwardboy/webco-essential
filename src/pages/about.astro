---
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import TestimonialList from "../components/TestimonialList.astro";
import { aboutIntro, aboutSections } from "../content/about";
import { testimonials } from "../content/testimonials";
import { trustPoints } from "../content/trust";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageCrumbs } from "../lib/links";

const crumbs = pageCrumbs([{ label: "About", href: "/about/" }]);
---

<BaseLayout
  title="About"
  description={`Example about page for an independent HGV instructor training from one base in ${site.location.town}. No accreditation, pass rate or named instructor is shown.`}
  crumbs={crumbs}
>
  <PageHero crumbs={crumbs} eyebrow={aboutIntro.eyebrow} title={aboutIntro.title} lede={aboutIntro.lede}>
    <div class="actions">
      <a class="button" href="/hgv-training/">View HGV training</a>
      <a class="button button-quiet" href="/contact/#enquiry">Enquire now</a>
    </div>
  </PageHero>

  {
    aboutSections.map((section, index) => (
      <Section id={section.id} title={section.heading} band={index % 2 === 0} narrow={true}>
        {section.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </Section>
    ))
  }

  <Section id="why" title="Why learners choose us" intro="The same example points used across the site. No figure is attached." band={true}>
    <ul class="trust">
      {
        trustPoints.map((point) => (
          <li>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    id="proof"
    title="Reviews"
    intro="Sample quotations for the layout. They are not real reviews. Accreditation logos are not shown, because none are claimed."
  >
    <TestimonialList items={testimonials} />
    <div class="actions">
      <a class="button button-quiet" href="/reviews/">Reviews page</a>
    </div>
  </Section>

  <CtaBand
    title="Talk to the provider"
    text="Ask about Category C, Category C+E or Driver CPC. The details on the contact page are placeholders."
  />
</BaseLayout>
