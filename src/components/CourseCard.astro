---
import type { Course } from "../content/courses";

interface Props {
  course: Course;
}

const { course } = Astro.props;
---

<li class="card">
  <p class="card-kicker">{course.kicker}</p>
  <h3><a href={course.path}>{course.title}</a></h3>
  <p>{course.summary}</p>
  <a class="text-link" href={course.path}>View {course.navLabel}</a>
</li>
