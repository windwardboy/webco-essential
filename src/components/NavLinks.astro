---
import { nav } from "../config/site";
import { isCurrentPath } from "../lib/links";

const pathname = Astro.url.pathname;
---

<ul class="nav">
  {
    nav.map((item) => {
      const children = item.children ?? [];
      const sectionCurrent = children.some((child) => isCurrentPath(pathname, child.href));
      const itemCurrent = isCurrentPath(pathname, item.href) && !sectionCurrent;
      return (
        <li class:list={[children.length > 0 && "nav-sub"]}>
          <a href={item.href} aria-current={itemCurrent ? "page" : undefined} class:list={[sectionCurrent && "is-section"]}>
            {item.label}
          </a>
          {children.length > 0 ? (
            <ul class="submenu" aria-label={item.label}>
              {children.map((child) => (
                <li>
                  <a href={child.href} aria-current={isCurrentPath(pathname, child.href) ? "page" : undefined}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          ) : null}
        </li>
      );
    })
  }
  <li><a class="button" href="/contact/#enquiry">Enquire now</a></li>
</ul>
