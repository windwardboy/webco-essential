---
interface Props {
  src: string;
  webp?: string;
  avif?: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  priority?: boolean;
}

const {
  src,
  webp = "",
  avif = "",
  alt,
  width,
  height,
  sizes = "(min-width: 56rem) 38vw, 100vw",
  priority = false,
} = Astro.props;
---

{
  src ? (
    <picture>
      {avif ? <source type="image/avif" srcset={avif} sizes={sizes} /> : null}
      {webp ? <source type="image/webp" srcset={webp} sizes={sizes} /> : null}
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        sizes={sizes}
        decoding={priority ? "sync" : "async"}
        fetchpriority={priority ? "high" : undefined}
      />
    </picture>
  ) : null
}
