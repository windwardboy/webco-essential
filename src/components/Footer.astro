---
import { trainingLinks } from "../content/courses";
import { site } from "../config/site";

const pageLinks = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/reviews/", label: "Reviews" },
  { href: "/contact/", label: "Contact" },
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-brand">
        <img src="/logo-mark-inverted.svg" width="36" height="36" alt="" />
        <span class="logo-word"><span class="logo-strong">Webco</span> Essential</span>
      </p>
      <p>{site.demoLine}. Sample content for a single-location HGV training website.</p>
      <p>
        <strong>{site.location.town}, {site.location.county}</strong>
      </p>
      <p class="example-caption">Placeholder location. No street address is published.</p>
      {
        site.webcoMediaUrl ? (
          <p>
            <a href={site.webcoMediaUrl}>Webco Media</a>
          </p>
        ) : (
          <p>Webco Media</p>
        )
      }
    </div>
    <div>
      <p class="footer-label">Training</p>
      <ul class="footer-nav">
        {
          trainingLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="footer-label">Pages</p>
      <ul class="footer-nav">
        {
          pageLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="footer-label">Example contact</p>
      <ul class="footer-nav">
        <li>
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
          <span class="example-tag">Example number</span>
        </li>
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span class="example-tag">Example address</span>
        </li>
        {
          site.showWhatsApp ? (
            <li>
              <a href={site.whatsappHref} rel="noopener noreferrer">
                WhatsApp
              </a>
              <span class="example-tag">Example number</span>
            </li>
          ) : null
        }
        <li>
          <a href="/contact/#enquiry">Enquiry form</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
