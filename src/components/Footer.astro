---
import BrandName from "./BrandName.astro";
import DemoByline from "./DemoByline.astro";
import { trainingLinks } from "../content/courses";
import { nav, site } from "../config/site";
import { httpsUrl } from "../lib/links";

const pageLinks = [
  { href: "/", label: "Home" },
  ...nav.flatMap((item) => (item.children ? [] : [{ href: item.href, label: item.label }])),
];
const whatsapp = site.showWhatsApp ? httpsUrl(site.whatsappHref) : null;
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-brand">
        <img src="/logo-mark-inverted.svg" width="36" height="36" alt="" />
        <BrandName />
      </p>
      <p>Category C, Category C+E and Driver CPC training from one local base.</p>
      <p>
        <strong>{site.location.town}, {site.location.county}</strong>
      </p>
      <p class="example-caption">
        <DemoByline />. The business, location and contact details are fictional.
      </p>
    </div>
    <div>
      <h2 class="footer-label" id="footer-training">Training</h2>
      <ul class="footer-nav" aria-labelledby="footer-training">
        {
          trainingLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="footer-label" id="footer-pages">Pages</h2>
      <ul class="footer-nav" aria-labelledby="footer-pages">
        {
          pageLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="footer-label" id="footer-contact">Contact</h2>
      <ul class="footer-nav" aria-labelledby="footer-contact">
        <li>
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
        </li>
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        {
          whatsapp ? (
            <li>
              <a href={whatsapp} rel="noopener noreferrer">WhatsApp {site.whatsappDisplay}</a>
            </li>
          ) : null
        }
        <li>
          <a href="/contact/#enquiry">Enquiry form</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
