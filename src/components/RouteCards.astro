---
import CourseCard from "./CourseCard.astro";
import { courses } from "../content/courses";
---

<section class="block band" aria-labelledby="routes">
  <div class="wrap">
    <div class="section-head">
      <h2 id="routes">Choose your training route</h2>
      <p class="section-intro">
        Three core routes for a provider with one base. If you are not sure which applies, start with the comparison.
      </p>
    </div>
    <ul class="route-grid">
      {courses.map((course) => <CourseCard course={course} />)}
      <li class="card">
        <p class="card-kicker">Not sure?</p>
        <h3><a href="/hgv-training/#which-licence">Compare the routes</a></h3>
        <p>Category C, Category C+E and Driver CPC, set out side by side.</p>
        <a class="text-link" href="/contact/?course=not-sure#enquiry">Ask which licence fits</a>
      </li>
    </ul>
  </div>
</section>
