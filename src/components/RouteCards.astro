---
import CourseCard from "./CourseCard.astro";
import { courses, enquiryHref, trainingOverviewPath, unsureCourseId } from "../content/courses";
---

<section class="block band" aria-labelledby="routes">
  <div class="wrap">
    <div class="section-head">
      <h2 id="routes">Choose your course</h2>
      <p class="section-intro">
        Three courses, taught from one base. If you're not sure which one you need, start with the comparison.
      </p>
    </div>
    <ul class="route-grid">
      {courses.map((course) => <CourseCard course={course} />)}
      <li class="card">
        <p class="card-kicker">Not sure?</p>
        <h3><a href={`${trainingOverviewPath}#which-licence`}>Compare the courses</a></h3>
        <p>Category C, Category C+E and Driver CPC, side by side.</p>
        <a class="text-link" href={enquiryHref(unsureCourseId)}>Ask which licence fits</a>
      </li>
    </ul>
  </div>
</section>
