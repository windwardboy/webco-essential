---
import { site } from "../config/site";

interface Props {
  id?: string;
  title: string;
  text: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  id = "cta",
  title,
  text,
  primaryHref = "/contact/#enquiry",
  primaryLabel = "Enquire now",
  secondaryHref = site.phoneHref,
  secondaryLabel = `Call ${site.phoneDisplay}`,
} = Astro.props;
---

<section class="cta-band" aria-labelledby={id}>
  <div class="wrap">
    <h2 id={id}>{title}</h2>
    <p>{text}</p>
    <div class="actions">
      <a class="button" href={primaryHref}>{primaryLabel}</a>
      <a class="button button-quiet" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>
